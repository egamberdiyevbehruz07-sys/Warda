# Set actual secret values in Render Dashboard > Environment. Do not commit secrets.
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BILLZ_TME_KEY=
# Optional comma-separated numeric Telegram user IDs allowed to open the Mini App individually.
# Group members are also allowed according to the configured Telegram group in Supabase.
TELEGRAM_ALLOWED_USER_IDS=
# Render normally supplies RENDER_EXTERNAL_URL automatically. Set PUBLIC_URL only if needed.
PUBLIC_URL=
